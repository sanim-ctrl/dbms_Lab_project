# Copy this file to ".env" and fill in your real values.
# The application (db.py) loads this file automatically at startup.
# .env is git-ignored -- NEVER commit it or paste real credentials into source.

# --- MySQL connection ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bloodbank_user
DB_PASSWORD=change_this_password
DB_NAME=blood_bank_db

# --- TLS for hosted MySQL (Aiven) ---
# Path to the CA certificate (Aiven "ca.pem"). When set, the connection uses
# verified TLS, which Aiven requires. On Render, upload ca.pem as a Secret File
# and set this to the mount path (Render mounts secret files under /etc/secrets).
# Leave unset for local MySQL.
# DB_SSL_CA=/etc/secrets/aiven-ca.pem
#
# On hosts that give you env vars but no mounted file (e.g. Vercel), paste the
# same ca.pem base64-encoded instead (same verified TLS, no file needed):
#   DB_SSL_CA_B64=$(base64 -w0 ca.pem)
#
# Optional: also verify the server hostname in the certificate (strictest).
# DB_SSL_VERIFY_IDENTITY=0
#
# Optional: set to 1 ONLY to force-disable TLS (e.g. a local server with no TLS).
# DB_SSL_DISABLED=0

# --- Flask ---
# Session/CSRF signing key -- use a long random string.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_this_to_a_long_random_string

# --- Admin approval workflow ---
# Admin sessions are signed with SECRET_KEY (required for admin access; at least
# 32 characters). FLASK_SECRET_KEY above is kept only as a legacy fallback for
# the rest of the app.
SECRET_KEY=change_this_to_a_long_random_secret_key

# Shared admin password, stored as a Werkzeug password hash (recommended).
# Generate the hash locally WITHOUT exposing the plaintext in source code or
# shell history:  python scripts/generate_admin_hash.py
ADMIN_PASSWORD_HASH=

# Plain-text fallback, used only when ADMIN_PASSWORD_HASH is not set.
# Less safe: prefer the hash above.  ADMIN_PASSWORD=

# Optional: admin session lifetime in minutes (default 30).
# ADMIN_SESSION_MINUTES=30
# Optional: brute-force protection for the admin login (defaults: 5 attempts/300s).
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_WINDOW_SECONDS=300

# Optional: stock is flagged "low" when below this many units (default 10).
LOW_STOCK_THRESHOLD=10

# --- Local dev server (app.py only) ---
# On Render these are provided automatically; Gunicorn binds to $PORT.
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=1
